# --- Database ---------------------------------------------------------
# Local dev: run `npm run db:up` to start Postgres in Docker (see
# docker-compose.yml), then use this connection string as-is.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moosa_portfolio?schema=public"

# Production (AWS RDS Postgres) — set the real value in the server's own
# .env, not here:
# DATABASE_URL="postgresql://USER:PASSWORD@YOUR-RDS-ENDPOINT.rds.amazonaws.com:5432/moosa_portfolio?schema=public"

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- First admin user (used only by `npm run db:seed`) -----------------
ADMIN_EMAIL="admin@moosasageer.dev"
ADMIN_PASSWORD="ChangeMe123!"

# --- Optional: cloud file storage ---------------------------------------
# By default, uploads are written to /public/uploads on the server's disk.
# This works for a single-server deploy but is NOT durable on most
# serverless hosts (e.g. Vercel). For production, connect Supabase Storage
# or S3 — see README "Cloud file storage" for the swap.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="portfolio-media"
